{
  "name": "folder-note-revamped",
  "version": "1.0.1",
  "description": "Folder Note Revamped: a revamp of xpgo's Folder Note plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js",
    "typecheck": "tsc --noEmit",
